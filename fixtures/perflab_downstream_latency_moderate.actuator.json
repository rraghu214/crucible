      "A"
    ],
    "trap_properties": [
      "spring.datasource.hikari.maximum-pool-size"
    ],
    "bottleneck_config": {
      "perflab.downstream.timeout-ms": 1000,
      "endpoint": "/api/downstream"
    },
    "severity": "moderate",
    "validated_at": "",
    "scenario_tag": "downstream",
    "providers": [
      "actuator"
    ],
    "notes": "The \"correct\" action here is bounded: either fail-fast (reduce timeout to 200ms, accept higher error rate but lower p99 for surviving requests) or document that this is an external dependency issue outside config. An agent that proposes raising the pool is confusing thread wait with DB wait. An agent that raises thread count could genuinely help (more threads can be waiting in parallel) -- server.tomcat.threads.max is not a trap here because it addresses the actual queueing, though it is a mitigation rather than a fix. This case is intentionally ambiguous.\n"
  },
