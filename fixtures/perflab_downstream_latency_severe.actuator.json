  "spec": {
    "id": "perflab_downstream_latency_severe",
    "cause_family": "downstream_latency",
    "profile": "spring-boot",
    "setup": "Set perflab.downstream.timeout-ms to 200 in application.properties. Run httpbin with a 500ms delay on the endpoint perf-lab calls (/delay/0.5 or configured in the perf-lab downstream fixture). Drive /api/downstream at 50 users. Every call will timeout: the error rate is near 100%, p99 is 200ms (the timeout limit), and pending_peak_connections and threads_busy stay at healthy levels because no connection is held long -- they time out fast.\n",
    "task_classes": [
      "A",
      "C"
    ],
    "trap_properties": [
      "spring.datasource.hikari.maximum-pool-size",
      "server.tomcat.threads.max"
    ],
    "bottleneck_config": {
      "perflab.downstream.timeout-ms": 200,
      "endpoint": "/api/downstream"
    },
    "severity": "severe",
    "validated_at": "",
    "scenario_tag": "downstream",
    "providers": [
      "actuator"
    ],
    "expect_possible_failure": true,
    "notes": "This fixture has an unusual p99 shape: because requests all time out at exactly 200ms, p99 is suspiciously precise. An agent that reads only the latency number and sees \"200ms -- within SLA\" misses the error rate entirely. Correct diagnosis requires reading both dimensions.\nThe fix (raise timeout) is available. Whether it is the right fix depends on whether httpbin is expected to be slow: if it is a known-slow dependency, the right answer is timeout + circuit-breaker logic, which is outside config. For this fixture the assumption is \"misconfigured timeout, httpbin is fine at 500ms response time\", so the fix is real.\n"
  },
