  "spec": {
    "id": "perflab_gc_pressure_moderate",
    "cause_family": "gc_pressure",
    "profile": "spring-boot",
    "setup": "Start perf-lab with -Xmx192m (the default is typically 256m or larger). Drive /api/churn at 50 users. The allocation-heavy workload under a constrained heap keeps GC running: pauses are real, frequent enough to show in gc_pause_count, but not so long that p99 explodes. This is the \"present but subtle\" severity for GC.\n",
    "task_classes": [
      "A",
      "B"
    ],
    "trap_properties": [],
    "bottleneck_config": {
      "perflab.jvm.heap-max-mb": 192,
      "endpoint": "/api/churn"
    },
    "severity": "moderate",
    "validated_at": "",
    "scenario_tag": "churn",
    "providers": [
      "actuator"
    ],
    "expect_possible_failure": false,
    "notes": "The moderate GC fixture exercises a subtler form of the lookalike problem: pool and thread saturation both look fine (as they should), and the only signal is a gc_pause_count that is clearly higher than the healthy baseline and a heap_used_peak_bytes that is near but not at ceiling. The test of \"reads the count, not just the max\" is sharper here than on the severe fixture.\n"
  },
