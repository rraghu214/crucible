{
  "spec": {
    "id": "perflab_gc_pressure",
    "cause_family": "gc_pressure",
    "profile": "spring-boot",
    "setup": "Start perf-lab with -Xmx128m and drive /api/churn, the allocation-heavy endpoint, at 50 users. The small heap plus sustained allocation keeps the collector busy: gc_pause_count climbs steadily and heap_used_peak_bytes sits near the ceiling, while the HikariCP fields stay entirely ordinary.\n",
    "task_classes": [
      "A",
      "B"
    ],
    "trap_properties": [
      "spring.datasource.hikari.maximum-pool-size"
    ],
    "bottleneck_config": {
      "perflab.jvm.heap-max-mb": 128,
      "endpoint": "/api/churn"
    },
    "severity": "severe",
    "validated_at": "",
    "scenario_tag": "churn",
    "providers": [
      "actuator",
      "promql",
      "datadog"
    ],
    "expect_possible_failure": false,
    "notes": "Watch the collector's max_recent_ms caveat on this fixture specifically. Micrometer's MAX is a rolling ~2-minute maximum that decays, so a GC pause early in a 300 s window has aged out by the time the window ends -- the collector names the field max_recent_ms rather than max_ms for exactly this reason, and GC is the cause where the under-reporting bites hardest. The count and the mean over the window are the fields that carry the signal here; the max is the one that will look smaller than the run felt.\n"
  },
