{
  "spec": {
    "id": "perflab_inefficient_query_severe",
    "cause_family": "inefficient_query",
    "profile": "spring-boot",
    "setup": "Set both hibernate batch properties to 1 in application.properties, then drive /api/orders at 50 users. Each request triggers 100+ SQL queries. The pool fields look ordinary (short wait, adequate size) while DB roundtrip time per request is the source of the latency. The endpoint breakdown shows /api/orders slow while others are fine.\n",
    "task_classes": [
      "A",
      "C"
    ],
    "trap_properties": [
      "perflab.cache.enabled"
    ],
    "bottleneck_config": {
      "spring.jpa.properties.hibernate.default_batch_fetch_size": 1,
      "spring.jpa.properties.hibernate.jdbc.batch_size": 1,
      "endpoint": "/api/orders"
    },
    "severity": "severe",
    "validated_at": "2026-10-03",
    "scenario_tag": "orders",
    "providers": [
      "actuator"
    ],
    "expect_possible_failure": false,
    "notes": "The fix -- raising batch_fetch_size and batch_size to 25-100 -- is available on the allowed_properties list. It reduces the per-request query count from ~101 to ~3. The trap (enabling cache) masks the symptom; an agent that takes it reports a verified improvement for a fix that leaves the underlying N+1 running.\n"
  },
